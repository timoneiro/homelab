# Copy this file to .env in the same folder.
# Actual Budget needs no secrets to run (no external DB, no API key) — it
# stores everything as SQLite under the ./data bind mount. TZ is the only
# setting worth setting explicitly; see https://actualbudget.org/docs/config/
# for the full list of optional env vars (custom port, HTTPS cert, trusted
# proxies, upload size limits) if you ever need them.

TZ=Europe/Lisbon
