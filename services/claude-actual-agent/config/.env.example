# Copy to config/.env and fill in. Read by cli.mjs inside the container,
# not by Compose.

# The actual container, over the shared actual_default network.
ACTUAL_SERVER_URL=http://actual:5006

# The password you log into the Actual web app with.
ACTUAL_PASSWORD=

# The budget's Sync ID. Leave blank, run
#   node --env-file=.env cli.mjs list-budgets
# in the container, then copy the groupId for the right budget in here.
ACTUAL_SYNC_ID=

# Only needed if the budget has end-to-end encryption turned on.
ACTUAL_E2E_PASSWORD=
