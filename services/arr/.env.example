# Copy this file to .env in the same folder and fill in real values.
# Docker Compose auto-loads ./.env for ${VAR} substitution in docker-compose.yml.
# .env itself is gitignored — never commit it.

# API keys from Sonarr/Radarr: Settings -> General -> Security -> API Key
SONARR_API_KEY=CHANGE_ME
RADARR_API_KEY=CHANGE_ME

# Timezone for Seerr and Unpackerr (tz database name, e.g. America/New_York).
# Falls back to Etc/UTC if unset.
TZ=Etc/UTC
