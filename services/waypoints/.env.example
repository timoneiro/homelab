# Copy this file to .env in the same folder and fill in real values.
# Docker Compose auto-loads ./.env for ${VAR} substitution in docker-compose.yml.
# .env itself is gitignored — never commit it.

# Folder on the HDD volume for the server's bulk storage: daily copies of the
# trip database now, documents and photos later. Create it first (for
# example as a shared folder on the HDD volume in UGOS), so it's a normal
# folder you can see and back up, rather than one Docker creates on its own.
WAYPOINTS_FILES_DIR=/volume1/waypoints
