# Copy this file to .env in the same folder and fill in a real value.
# Docker Compose auto-loads ./.env for ${VAR} substitution in docker-compose.yml.
# .env itself is gitignored — never commit it.

# Generate a fresh auth key: https://login.tailscale.com/admin/settings/keys
# (reusable + ephemeral/pre-approved as needed for this node)
TS_AUTHKEY=CHANGE_ME

# Pi-hole admin web UI password. Pi-hole v6 reads this via
# FTLCONF_webserver_api_password in the compose file (the old WEBPASSWORD
# env var is deprecated).
PIHOLE_PASSWORD=CHANGE_ME
