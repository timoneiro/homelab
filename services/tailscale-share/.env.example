# Copy this file to .env in the same folder and fill in real values.
# Docker Compose auto-loads ./.env for ${VAR} substitution in docker-compose.yml.
# .env itself is gitignored — never commit it.

# Auth key for the `share` machine: https://login.tailscale.com/admin/settings/keys
# Use a one-off (not reusable) key. After it joins, turn off key expiry for
# `share` in the admin console, or friends lose access when it expires.
TS_AUTHKEY=CHANGE_ME
