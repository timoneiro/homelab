# Copy this file to .env in the same folder and fill in real values.
# Immich reads this file directly (env_file:) AND docker-compose.yml uses
# some of these for ${VAR} substitution (UPLOAD_LOCATION, IMMICH_VERSION).
# .env itself is gitignored — never commit it.

# The Immich version to pull (matches a GitHub release tag), or "release" for latest stable
IMMICH_VERSION=release

# Where Immich stores your photos/videos on the host
UPLOAD_LOCATION=CHANGE_ME

# Where Postgres stores its data on the host
DB_DATA_LOCATION=CHANGE_ME

# Postgres credentials used by the immich-server and database containers
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE_NAME=immich
