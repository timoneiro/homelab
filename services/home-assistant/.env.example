# Copy this file to .env in the same folder and fill it in.
# .env itself is gitignored — never commit it.

# Timezone for automations, schedules and history (tz database name).
TZ=Etc/UTC

# Mosquitto (MQTT broker) logins. Use long random strings. Home Assistant's
# MQTT integration asks for the first one (user `homeassistant`); the second
# goes into Zigbee2MQTT's .env (user `zigbee2mqtt`).
MQTT_HA_PASSWORD=change-me
MQTT_Z2M_PASSWORD=change-me
