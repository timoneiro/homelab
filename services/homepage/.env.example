# Copy this file to .env in the same folder and fill in real values.
# Docker Compose auto-loads ./.env for ${VAR} substitution in docker-compose.yml,
# and Homepage reads any HOMEPAGE_VAR_* variable for use in config/*.yaml via
# {{HOMEPAGE_VAR_NAME}} templating. .env itself is gitignored — never commit it.

# Homepage runs on Next.js, which rejects requests whose Host header isn't
# in this list ("host validation failed"). List every host:port you'll
# actually browse to it by, comma-separated, no spaces.
HOMEPAGE_ALLOWED_HOSTS=192.168.1.245:3000,100.66.227.104:3000,localhost:3000,nas.tailXXXXXX.ts.net:8443

# Not secret, but personal — kept out of the committed config/*.yaml files
# via {{HOMEPAGE_VAR_*}} templating.
# Dashboard title (settings.yaml).
HOMEPAGE_VAR_TITLE=Homelab
# This NAS's MagicDNS name, <TS_HOSTNAME>.<tailnet>.ts.net — used for links
# that go through `tailscale serve` (services.yaml). Find it in the
# Tailscale admin console → Machines.
HOMEPAGE_VAR_TS_FQDN=nas.tailXXXXXX.ts.net

# Sonarr/Radarr/Prowlarr/Bazarr: Settings -> General -> Security -> API Key
HOMEPAGE_VAR_SONARR_API_KEY=CHANGE_ME
HOMEPAGE_VAR_RADARR_API_KEY=CHANGE_ME
HOMEPAGE_VAR_PROWLARR_API_KEY=CHANGE_ME
HOMEPAGE_VAR_BAZARR_API_KEY=CHANGE_ME

# qBittorrent: same login you use for its WebUI
HOMEPAGE_VAR_QBITTORRENT_USERNAME=admin
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=CHANGE_ME

# Immich: Account Settings -> API Keys -> New API Key
HOMEPAGE_VAR_IMMICH_API_KEY=CHANGE_ME

# Pi-hole: same value as PIHOLE_PASSWORD in services/tailscale/.env
HOMEPAGE_VAR_PIHOLE_PASSWORD=CHANGE_ME
