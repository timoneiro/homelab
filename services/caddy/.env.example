# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token ->
# "Edit zone DNS" template, Zone Resources: Include -> Specific zone ->
# timoneiro.app. Paste it here on the NAS only, never in the repo.
CF_API_TOKEN=

# The NAS's Tailscale IP (100.x.y.z), the same one *.home.timoneiro.app
# points at in Cloudflare DNS.
CADDY_BIND=
